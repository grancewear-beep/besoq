{
  "_meta": {
    "name": "besoq design tokens",
    "version": "1.0.0",
    "format": "design-tokens-community-group",
    "documentation": "brand/07-tokens/README.md"
  },
  "color": {
    "$type": "color",
    "bone":     { "value": "#F4EFE6", "description": "Primary background. Warm paper-coloured off-white." },
    "ash":      { "value": "#1A1A1A", "description": "Primary foreground. Near-black with faint warmth." },
    "stone":    { "value": "#A89B8C", "description": "Warm taupe. Secondary text, supporting strokes." },
    "sage":     { "value": "#9CA38F", "description": "Muted green. Spring/summer accent only." },
    "charcoal": { "value": "#3C3C3C", "description": "Mid-deep warm gray. Long-form body text." },

    "linen":    { "value": "#E4DDCE", "description": "Deeper bone for panel backgrounds." },
    "clay":     { "value": "#B89F86", "description": "Warm beige. Autumn/winter accent." },
    "ink":      { "value": "#11110F", "description": "Near-black, slightly deeper than Ash. Foiling only." },

    "neutral": {
      "50":  { "value": "#FAF7F0" },
      "100": { "value": "#F4EFE6" },
      "200": { "value": "#E4DDCE" },
      "300": { "value": "#CFC6B4" },
      "400": { "value": "#A89B8C" },
      "500": { "value": "#7A7163" },
      "600": { "value": "#564F44" },
      "700": { "value": "#3C3C3C" },
      "900": { "value": "#1A1A1A" }
    },

    "state": {
      "success": { "value": "#5C6B53", "description": "Quiet green. UI confirmation." },
      "warning": { "value": "#A48852", "description": "Quiet ochre. UI low-stock / address prompt." },
      "error":   { "value": "#8C4A3F", "description": "Quiet red. UI validation error." }
    }
  },

  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "value": ["Söhne", "Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"]
      },
      "serif": {
        "$type": "fontFamily",
        "value": ["Times Now", "Source Serif 4", "Source Serif Pro", "Georgia", "Times New Roman", "Times", "serif"]
      },
      "mono": {
        "$type": "fontFamily",
        "value": ["Söhne Mono", "JetBrains Mono", "ui-monospace", "SFMono-Regular", "SF Mono", "Menlo", "Consolas", "Liberation Mono", "monospace"]
      }
    },

    "weight": {
      "$type": "fontWeight",
      "light":    { "value": 300 },
      "regular":  { "value": 400 },
      "semibold": { "value": 600 }
    },

    "size": {
      "$type": "dimension",
      "3xs":  { "value": "11px" },
      "2xs":  { "value": "12px" },
      "xs":   { "value": "13px" },
      "sm":   { "value": "14px" },
      "base": { "value": "16px" },
      "md":   { "value": "18px" },
      "lg":   { "value": "22px" },
      "xl":   { "value": "28px" },
      "2xl":  { "value": "36px" },
      "3xl":  { "value": "48px" },
      "4xl":  { "value": "64px" },
      "5xl":  { "value": "84px" }
    },

    "lineHeight": {
      "display":   { "value": 1.00 },
      "tight":     { "value": 1.10 },
      "snug":      { "value": 1.35 },
      "normal":    { "value": 1.55 },
      "serif":     { "value": 1.65 },
      "editorial": { "value": 1.75 }
    },

    "letterSpacing": {
      "0":         { "value": "0" },
      "caps":      { "value": "0.05em" },
      "wordmark":  { "value": "0.12em" },
      "editorial": { "value": "0.20em" }
    }
  },

  "space": {
    "$type": "dimension",
    "0":  { "value": "0" },
    "1":  { "value": "4px" },
    "2":  { "value": "8px" },
    "3":  { "value": "12px" },
    "4":  { "value": "16px" },
    "5":  { "value": "24px" },
    "6":  { "value": "32px" },
    "7":  { "value": "48px" },
    "8":  { "value": "64px" },
    "9":  { "value": "96px" },
    "10": { "value": "128px" },
    "11": { "value": "192px" },
    "12": { "value": "256px" }
  },

  "container": {
    "$type": "dimension",
    "sm":    { "value": "100%" },
    "md":    { "value": "768px" },
    "lg":    { "value": "1024px" },
    "xl":    { "value": "1280px" },
    "prose": { "value": "72ch" }
  },

  "radius": {
    "$type": "dimension",
    "description": "All radii are 0. Square corners are part of the brand.",
    "0":    { "value": "0" },
    "sm":   { "value": "0" },
    "md":   { "value": "0" },
    "lg":   { "value": "0" },
    "full": { "value": "0" }
  },

  "border": {
    "width": {
      "$type": "dimension",
      "hair":    { "value": "0.5px" },
      "default": { "value": "1px" },
      "strong":  { "value": "2px" }
    }
  },

  "duration": {
    "$type": "duration",
    "instant": { "value": "0ms" },
    "fast":    { "value": "120ms" },
    "base":    { "value": "160ms" },
    "slow":    { "value": "200ms" },
    "loop":    { "value": "1200ms" }
  },

  "easing": {
    "$type": "cubicBezier",
    "out":    { "value": [0.22, 1, 0.36, 1] },
    "linear": { "value": [0, 0, 1, 1] }
  },

  "z": {
    "$type": "number",
    "base":    { "value": 0 },
    "raised":  { "value": 10 },
    "sticky":  { "value": 100 },
    "overlay": { "value": 1000 },
    "modal":   { "value": 1100 },
    "toast":   { "value": 1200 }
  },

  "brand": {
    "name":              { "value": "besoq" },
    "name-editorial":    { "value": "BESOQ" },
    "monogram":          { "value": "bsq" },
    "tagline-master":    { "value": "be so quiet." },
    "tagline-editorial": { "value": "whisper, don't shout." },
    "signoff":           { "value": "— besoq" }
  }
}
